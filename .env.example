# Django secret key used for cryptographic signing (required; use a long random value in production)
SECRET_KEY='change-me-to-a-random-secret-key'

# Enable Django debug mode for local development only (True/False)
DEBUG=True

# Comma-separated hostnames allowed to serve this app
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL connection string for Neon/database (use a real URL in deployment)
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'

# Comma-separated trusted origins for CSRF checks (include https:// URLs)
CSRF_TRUSTED_ORIGINS=https://example.onrender.com

# Demo login username for seeded or sample access
DEMO_USERNAME=demo_user

# Demo login password for seeded or sample access
DEMO_PASSWORD=demo_password
